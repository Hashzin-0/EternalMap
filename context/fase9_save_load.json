    "indexeddb_storage": {
      "nome": "IndexedDB Storage",
      "descricao": "Sistema de armazenamento persistente no browser",
      "subtopicos": {
        "database_structure": {
          "nome": "Database Structure",
          "descricao": "Schema do banco de dados IndexedDB",
          "database_name": "eternalmap_saves",
          "object_stores": [
            {
              "nome": "saves",
              "keyPath": "slotId",
              "indexes": [
                {"nome": "timestamp", "unique": false},
                {"nome": "gameDate", "unique": false},
                {"nome": "countryId", "unique": false}
              ]
            },
            {
              "nome": "settings",
              "keyPath": "key"
            },
            {
              "nome": "metadata",
              "keyPath": "version"
            }
          ]
        },
        "storage_operations": {
          "nome": "Storage Operations",
          "descricao": "Operações CRUD no IndexedDB",
          "operacoes": {
            "save": {
              "descricao": "Salvar estado do jogo",
              "passos": [
                "1. Get game state from Zustand stores",
                "2. Create save object with metadata",
                "3. Serialize to JSON",
                "4. Compress with LZ-string",
                "5. Open IndexedDB transaction",
                "6. Write to 'saves' store",
                "7. Update save slot metadata"
              ]
            },
            "load": {
              "descricao": "Carregar estado do jogo",
              "passos": [
                "1. Read from 'saves' store by slotId",
                "2. Decompress data",
                "3. Parse JSON",
                "4. Validate version compatibility",
                "5. Dispatch to Zustand stores",
                "6. Reinitialize Phaser scene",
                "7. Verify state integrity"
              ]
            },
            "delete": {
              "descricao": "Excluir save",
              "passos": [
                "1. Open transaction",
                "2. Delete from 'saves' store",
                "3. Update UI slot list"
              ]
            },
            "list": {
              "descricao": "Listar saves disponíveis",
              "passos": [
                "1. Open cursor on 'saves' store",
                "2. Read metadata (no full data)",
                "3. Return list sorted by timestamp"
              ]
            }
          }
        },
        "error_handling": {
          "nome": "Error Handling",
          "descricao": "Tratamento de erros de armazenamento",
          "cenarios": [
            {"cenario": "Storage full", "solucao": "Alert user, suggest deleting old saves"},
            {"cenario": "Corrupted data", "solucao": "Validate JSON parse, show error, offer recovery"},
            {"cenario": "Version mismatch", "solucao": "Run migration or show incompatibility message"},
            {"cenario": "IndexedDB not available", "solucao": "Fallback to localStorage with size warning"}
